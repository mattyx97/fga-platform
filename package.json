{
  "name": "nuxt-full-stack-starter",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "trap '$npm_execpath run infra:dev-down' INT TERM EXIT; $npm_execpath run infra:dev-up && nuxt dev",
    "build": "nuxt build --dotenv .env",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "cd ./server/lib/database && drizzle-kit generate",
    "db:migrate": "cd ./server/lib/database && drizzle-kit migrate",
    "db:push": "cd ./server/lib/database && drizzle-kit push",
    "db:studio": "cd ./server/lib/database && drizzle-kit studio",
    "ai:studio": "mastra studio -p 4111 --server-port 3000 --server-api-prefix /api/_mastra",
    "infra:dev-up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "infra:dev-down": "docker compose -f docker-compose.dev.yml down",
    "infra:dev-reset": "docker compose -f docker-compose.dev.yml down -v --remove-orphans --rmi local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@mastra/core": "^1.79.0",
    "@mastra/memory": "^1.39.0",
    "@mastra/observability": "^1.21.0",
    "@mastra/pg": "^1.32.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.1",
    "@nuxt/image": "^2.2.0",
    "@nuxt/ui": "^4.12.0",
    "@peterbud/nuxt-query": "^1.12.0",
    "@tanstack/vue-query": "^5.104.5",
    "@vueuse/nuxt": "^15.0.0",
    "better-auth": "^1.7.12",
    "consola": "^3.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "flydrive": "^2.2.0",
    "nodemailer": "^10.2.1",
    "nuxt": "^4.6.2",
    "nuxt-authorization": "^0.3.5",
    "nuxt-email-renderer": "^2.11.2",
    "pg": "^8.23.1",
    "stripe": "^23.0.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@mastra/hono": "^1.7.21",
    "@mastra/server": "^1.79.0",
    "@nuxt/devtools-kit": "^3.4.4",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.6.0",
    "mastra": "^1.35.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
